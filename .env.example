# ---------------------------------------------------------------------------
# SecureShop API - Example environment file
# Copy this to ".env" and fill in your own LOCAL, NON-PRODUCTION values.
# Never commit your real .env file.
# ---------------------------------------------------------------------------

# Flask
FLASK_ENV=development
FLASK_DEBUG=true
PORT=5000

# Secret used to sign JWTs - generate your own random value for local use.
# Example generation (Python): python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-random-local-secret

# JWT token lifetime, in minutes
JWT_EXP_MINUTES=60

# SQLite database file (relative to project root)
DATABASE_PATH=database/secureshop.db

# Rate limiting (login attempts per window, per IP)
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW_SECONDS=60

# ---------------------------------------------------------------------------
# TRAINING MODE
# Must be explicitly set to "true" (all lowercase) to activate.
# Any other value, or leaving it unset, means training mode is OFF.
# See README.md "Training Mode" section before enabling.
# ---------------------------------------------------------------------------
TRAINING_MODE=false

# Optional: fix which vulnerability scenarios are enabled for a reproducible
# build, as a comma-separated list of scenario codes (see docs/developer-
# remediation-guide.md for the codes). Leave blank to select randomly each
# time the database is initialized while TRAINING_MODE=true.
TRAINING_SCENARIOS=
